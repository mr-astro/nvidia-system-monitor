{
  "refresh_interval_seconds": 1.0,
  "temperature_unit": "C",
  "theme": "dark",
  "logging_enabled": true,

  "panels": {
    "cpu": true,
    "gpu": true,
    "ram": true,
    "storage": true,
    "sensors": false
  },

  "color_scheme": {
    "low_usage_color": "#4CAF50",
    "medium_usage_color": "#FFA726",
    "high_usage_color": "#EF5350"
  },

  "thresholds": {
    "medium_percent": 60,
    "high_percent": 85
  }
}

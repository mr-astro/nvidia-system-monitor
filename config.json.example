{
  "refresh_interval_seconds": 1.0,
  "temperature_unit": "C",
  "theme": "dark",
  "logging_enabled": true,

  "panels": {
    "cpu": true,
    "gpu": true,
    "ram": true,
    "storage": true,
    "sensors": false
  },

  "color_scheme": {
    "low_usage_color": "#4CAF50",
    "medium_usage_color": "#FFA726",
    "high_usage_color": "#EF5350"
  },

  "thresholds": {
    "medium_percent": 60,
    "high_percent": 85
  },

  "storage_usage": {
    "thresholds": {"medium_percent": 70, "high_percent": 85},
    "color_scheme": {
      "low_usage_color": "#76B900",
      "medium_usage_color": "#E5A93D",
      "high_usage_color": "#E65B57"
    }
  }
}
